DOCKER_TAG=main
# From Jenkins: Manage Jenkins > Nodes > <agent> (shown in the launch command)
JENKINS_SECRET=secret

# Agent identity / connection
JENKINS_URL=http://jenkins:8080
JENKINS_AGENT_NAME=amd64
JENKINS_AGENT_WORKDIR=/home/jenkins/agent

# Host docker group ID: stat -c %g /var/run/docker.sock
DOCKER_GID=984

# true = controller runs on this host (join its network); false = standalone host
JENKINS_NETWORK_EXTERNAL=true

# Image source
DOCKER_REGISTRY=ghcr.io
DOCKER_PUBLISHER=kostelidisdev

# Optional overrides — size for your heaviest build
TZ=Europe/Athens
JENKINS_AGENT_CPU_LIMIT=2
JENKINS_AGENT_MEMORY_LIMIT=2G
JENKINS_AGENT_MEMORY_RESERVATION=512M
JENKINS_AGENT_PIDS_LIMIT=4096
